{
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.minharotinacapilar.com"
        }
      ],
      "destination": "https://minharotinacapilar.com/$1",
      "permanent": true
    }
  ]
}
